# Required for production chain reads and transaction verification.
TATUM_API_KEY=
# Optional development-only mainnet RPC override; shown as a dev RPC badge.
NAKAMA_DEV_SUI_RPC=
# Walrus Memory mainnet relayer credentials.
MEMWAL_MAINNET_KEY=
MEMWAL_MAINNET_ACCOUNT_ID=
# Crew recap, generated only from recalled memory.
OPENROUTER_API_KEY=
NAKAMA_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Omit this to keep all joins as dry-runs.
NAKAMA_ALLOW_MAINNET=
NAKAMA_PORT=8787

# Optional Vite development port; proxy follows NAKAMA_PORT.
NAKAMA_VITE_PORT=5173
