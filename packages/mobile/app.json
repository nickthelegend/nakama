{
  "expo": {
    "name": "Nakama",
    "slug": "nakama-crew",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "nakama",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFF4E6",
    "android": {
      "package": "xyz.nakama.crew",
      "adaptiveIcon": { "foregroundImage": "./assets/icon.png", "backgroundColor": "#FFE3A3" },
      "permissions": ["CAMERA", "POST_NOTIFICATIONS"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-image",
      ["expo-camera", { "cameraPermission": "Nakama scans crew invite QR codes." }],
      ["expo-notifications", { "color": "#FF6F59" }]
    ],
    "experiments": { "typedRoutes": false }
  }
}
